/// Tabla calendario central para analizar ventas y cobranzas con una dimensión temporal común.
table Calendario
	lineageTag: 5b329ec7-d46e-47b8-a25d-e676c941b015
	dataCategory: Time

	column Fecha
		isKey
		formatString: Short Date
		lineageTag: 7de89a73-bdfe-4ed2-9718-01516e63dc6f
		summarizeBy: none
		sourceColumn: [Date]

	column Año = YEAR(Calendario[Fecha])
		dataType: int64
		formatString: 0
		summarizeBy: none

	column Mes = FORMAT(Calendario[Fecha], "mmmm")
		dataType: string
		summarizeBy: none
		sortByColumn: NroMes

	column NroMes = MONTH(Calendario[Fecha])
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none

	column Día = DAY(Calendario[Fecha])
		dataType: int64
		formatString: 0
		summarizeBy: none

	column Trimestre = "T" & FORMAT(QUARTER(Calendario[Fecha]), "0")
		dataType: string
		summarizeBy: none
		sortByColumn: NroTrimestre

	column NroTrimestre = QUARTER(Calendario[Fecha])
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none

	column 'Día semana' = FORMAT(Calendario[Fecha], "dddd")
		dataType: string
		summarizeBy: none
		sortByColumn: NroDiaSemana

	column NroDiaSemana = WEEKDAY(Calendario[Fecha], 2)
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none

	partition Calendario-1c5999b8-5c14-45a7-86a6-ef6d0368cd0b = calculated
		mode: import
		source = ```
				VAR FechaMin =
					MIN(
						MIN(Facturas[FechaFactura]),
						MIN(Cobranzas[FechaCobro])
					)
				VAR FechaMax =
					MAX(
						MAX(Facturas[FechaFactura]),
						MAX(Cobranzas[FechaCobro])
					)
				RETURN
					CALENDAR(
						DATE(YEAR(FechaMin), 1, 1),
						DATE(YEAR(FechaMax), 12, 31)
					)
				```
