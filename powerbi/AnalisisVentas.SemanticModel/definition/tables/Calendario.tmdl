/// Tabla calendario central para analizar ventas y cobranzas con una dimensión temporal común.
table Calendario
	lineageTag: 5b329ec7-d46e-47b8-a25d-e676c941b015
	dataCategory: Time

	column Fecha
		isKey
		formatString: Short Date
		lineageTag: 7de89a73-bdfe-4ed2-9718-01516e63dc6f
		summarizeBy: none
		sourceColumn: [Date]

		changedProperty = FormatString

		annotation SummarizationSetBy = Automatic

	column Año = YEAR(Calendario[Fecha])
		dataType: int64
		formatString: 0
		lineageTag: 3080ba75-e892-48b0-84c3-0d7ef69f8f47
		summarizeBy: none

		annotation SummarizationSetBy = User

	column Mes = FORMAT(Calendario[Fecha], "mmmm")
		dataType: string
		lineageTag: feea499d-0dc6-437b-b821-a0dcc41636e1
		summarizeBy: none
		sortByColumn: NroMes

		changedProperty = SortByColumn

		annotation SummarizationSetBy = User

	column NroMes = MONTH(Calendario[Fecha])
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none

		annotation SummarizationSetBy = User

	column Día = DAY(Calendario[Fecha])
		dataType: int64
		formatString: 0
		lineageTag: bcea24d4-e178-441f-872c-3017e738f29d
		summarizeBy: none

		annotation SummarizationSetBy = User

	column Trimestre = "T" & FORMAT(QUARTER(Calendario[Fecha]), "0")
		dataType: string
		lineageTag: c3bf0bf2-7450-4b33-9c7d-e895a0074345
		summarizeBy: none
		sortByColumn: NroTrimestre

		changedProperty = SortByColumn

		annotation SummarizationSetBy = User

	column NroTrimestre = QUARTER(Calendario[Fecha])
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Día semana' = FORMAT(Calendario[Fecha], "dddd")
		dataType: string
		lineageTag: eea5c796-7a64-4fff-9375-3e8aaa56c645
		summarizeBy: none
		sortByColumn: NroDiaSemana

		changedProperty = DataType
		changedProperty = SortByColumn

		annotation SummarizationSetBy = User

	column NroDiaSemana = WEEKDAY(Calendario[Fecha], 2)
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none

		annotation SummarizationSetBy = User

	partition Calendario-1c5999b8-5c14-45a7-86a6-ef6d0368cd0b = calculated
		mode: import
		source = ```
				VAR FechaMin =
					MIN(
						MIN(Facturas[FechaFactura]),
						MIN(Cobranzas[FechaCobro])
					)
				VAR FechaMax =
					MAX(
						MAX(Facturas[FechaFactura]),
						MAX(Cobranzas[FechaCobro])
					)
				RETURN
					CALENDAR(
						DATE(YEAR(FechaMin), 1, 1),
						DATE(YEAR(FechaMax), 12, 31)
					)
				```

	annotation PBI_Id = 22c984e2cfef446fbec21efc1f2a674d
