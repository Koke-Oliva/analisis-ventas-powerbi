/// Medidas de negocio utilizadas en el informe de ventas y cobranzas.
table Medidas
	lineageTag: 6fba6e40-f422-4718-8c58-5d669873044d

	/// Importe total facturado.
	measure 'Total Ventas' = SUM(Facturas[Monto Factura])
		formatString: #,0
		displayFolder: Ventas
		lineageTag: 19e9231f-2b84-42dd-bf6a-b6f502b608a3

	/// Importe total cobrado.
	measure 'Total Cobros' = SUM(Cobranzas[MontoCobrado])
		formatString: #,0
		displayFolder: Cobranzas
		lineageTag: 474c8e24-826d-4440-95e9-3516a6cbe75c

	/// Diferencia neta entre ventas y cobros. Conserva el signo para no ocultar posibles sobrecobros.
	measure 'Saldo Pendiente' = [Total Ventas] - [Total Cobros]
		formatString: #,0;[Red]-#,0
		displayFolder: Cobranzas

	/// Proporción del importe cobrado respecto del importe vendido.
	measure 'Tasa Cobranza' = DIVIDE([Total Cobros], [Total Ventas])
		formatString: 0.0%
		displayFolder: Cobranzas

	/// Número de facturas dentro del contexto de filtro.
	measure 'Cantidad Facturas' = COUNTROWS(Facturas)
		formatString: #,0
		displayFolder: Volumen

	/// Clientes únicos que registran al menos una factura dentro del contexto de filtro.
	measure 'Clientes con venta' = DISTINCTCOUNT(Facturas[IDCliente])
		formatString: #,0
		displayFolder: Volumen

	/// Importe promedio por factura dentro del contexto de filtro.
	measure 'Ticket Promedio' = DIVIDE([Total Ventas], [Cantidad Facturas])
		formatString: #,0.00
		displayFolder: Ventas

	/// Mayor importe observado en una factura.
	measure 'Venta más alta' = MAX(Facturas[Monto Factura])
		formatString: #,0.00
		displayFolder: Ventas
		lineageTag: 1691eef5-abf5-4417-a5a0-9765b8af90c2

	/// Menor importe observado en una factura.
	measure 'Venta más baja' = MIN(Facturas[Monto Factura])
		formatString: #,0.00
		displayFolder: Ventas
		lineageTag: 79343d2e-d588-4a6a-b23b-52364b128802

	/// Medida original de la evaluación, mantenida para trazabilidad.
	measure 'Promedio Ventas' = AVERAGE(Facturas[Monto Factura])
		formatString: #,0.00
		displayFolder: "Evaluación original"
		isHidden
		lineageTag: 2274d5f8-a960-4949-9135-9e97ae1bb5d2

	/// Medida original de la evaluación, mantenida para trazabilidad.
	measure 'Cantidad Ventas' = COUNTROWS(Facturas)
		formatString: #,0
		displayFolder: "Evaluación original"
		isHidden
		lineageTag: b86a00a7-6762-46b5-9c9f-cfb4c94033e2

	/// Medida original de la evaluación, mantenida para trazabilidad.
	measure 'Cantidad Clientes' = DISTINCTCOUNT(Clientes[IDCliente])
		formatString: #,0
		displayFolder: "Evaluación original"
		isHidden
		lineageTag: d5434d07-52db-4f8f-b1ec-27c1c300e5cc

	/// Medida original de la evaluación, mantenida para trazabilidad.
	measure 'Cobros sobre Ventas' = DIVIDE([Total Cobros], [Total Ventas])
		formatString: 0.0%
		displayFolder: "Evaluación original"
		isHidden

	/// Medida original de la evaluación, mantenida solo por trazabilidad.
	measure Deuda = ABS([Total Ventas] - [Total Cobros])
		formatString: #,0.00
		displayFolder: "Evaluación original"
		isHidden
		lineageTag: 09f6eb7e-b550-443e-b9f0-876bfb830f7c

	partition Medidas-55f41787-5a3d-417b-b9df-ebb755c3a182 = m
		mode: import
